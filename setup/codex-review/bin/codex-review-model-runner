#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SETUP_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

require_env() {
  local name="$1"
  if [ -z "${!name:-}" ]; then
    echo "missing required environment variable: ${name}" >&2
    exit 1
  fi
}

require_env CODEX_REVIEW_PROMPT_PATH
require_env CODEX_REVIEW_OUTPUT_PATH
require_env CODEX_REVIEW_EXPECTED_SCHEMA
require_env CODEX_REVIEW_CODEX_ARGS_JSON
require_env AI_RELAY_API_KEY

schema_path="${SETUP_ROOT}/schemas/${CODEX_REVIEW_EXPECTED_SCHEMA}.schema.json"
if [ ! -f "$schema_path" ]; then
  echo "missing output schema: ${schema_path}" >&2
  exit 1
fi

if [ ! -f "$CODEX_REVIEW_PROMPT_PATH" ]; then
  echo "missing prompt file: ${CODEX_REVIEW_PROMPT_PATH}" >&2
  exit 1
fi

model_cwd="${CODEX_REVIEW_MODEL_CWD:-${CODEX_REVIEW_TRUSTED_CHECKOUT:-$(pwd)}}"
if [ ! -d "$model_cwd" ]; then
  echo "model command cwd does not exist: ${model_cwd}" >&2
  exit 1
fi

codex_args=()
while IFS= read -r arg; do
  codex_args+=("$arg")
done < <(
  python3 - <<'PY'
import json
import os

raw = os.environ["CODEX_REVIEW_CODEX_ARGS_JSON"]
try:
    value = json.loads(raw)
except json.JSONDecodeError as exc:
    raise SystemExit(f"CODEX_REVIEW_CODEX_ARGS_JSON must be valid JSON: {exc}") from exc

if not isinstance(value, list) or not all(isinstance(item, str) for item in value):
    raise SystemExit("CODEX_REVIEW_CODEX_ARGS_JSON must be a JSON array of strings")

for item in value:
    print(item)
PY
)

tmp_output="$(mktemp "${RUNNER_TEMP:-/tmp}/codex-review-model.XXXXXX.json")"
trap 'rm -f "$tmp_output"' EXIT

codex_bin="${CODEX_REVIEW_CODEX_BIN:-codex}"
if "$codex_bin" exec --help 2>&1 | grep -q -- "--ask-for-approval"; then
  "$codex_bin" exec \
    "${codex_args[@]}" \
    --sandbox read-only \
    --ask-for-approval never \
    --ephemeral \
    -C "$model_cwd" \
    --output-schema "$schema_path" \
    --output-last-message "$tmp_output" \
    < "$CODEX_REVIEW_PROMPT_PATH"
else
  "$codex_bin" exec \
    "${codex_args[@]}" \
    --sandbox read-only \
    --ephemeral \
    -C "$model_cwd" \
    --output-schema "$schema_path" \
    --output-last-message "$tmp_output" \
    < "$CODEX_REVIEW_PROMPT_PATH"
fi

python3 - "$tmp_output" "$CODEX_REVIEW_OUTPUT_PATH" <<'PY'
import json
import pathlib
import sys

source = pathlib.Path(sys.argv[1])
dest = pathlib.Path(sys.argv[2])

try:
    payload = json.loads(source.read_text(encoding="utf-8"))
except json.JSONDecodeError as exc:
    raise SystemExit(f"Codex model output was not valid JSON: {exc}") from exc

dest.parent.mkdir(parents=True, exist_ok=True)
dest.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY
