{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodexReviewFindings",
  "description": "Output schema for each axis agent in Stage 1 of Codex PR review v2. Each axis returns an array of findings plus optional metadata. Direct comment posting is forbidden — post-script handles posting based on tech-lead decisions plus hard rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent", "findings"],
  "properties": {
    "agent": {
      "type": "string",
      "enum": [
        "correctness",
        "security",
        "performance",
        "test-coverage",
        "domain"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(correctness|security|performance|test-coverage|domain)-[0-9]+$",
            "description": "<agent>-<seq> e.g. security-1, correctness-3"
          },
          "type": {
            "type": "string",
            "enum": ["MUST", "SUGGEST", "IMO", "NITS", "ASK"]
          },
          "file": {
            "type": "string",
            "description": "Path from repository root. Optional when cross_cutting=true."
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Line number in the PR head commit. Required for inline comments."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "One-line conclusion in Korean."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "2-5 lines of rationale in Korean."
          },
          "rule_ref": {
            "type": "string",
            "maxLength": 200,
            "description": "Optional reference (file path, ESLint rule name, or critical keyword such as 'framework-fidelity-critical')."
          },
          "cross_cutting": {
            "type": "boolean",
            "default": false,
            "description": "When true, this finding has no specific file/line and belongs in the summary comment only."
          }
        }
      }
    },
    "positive": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "description": "Up to 2 positive observations. Aggregated into summary comment."
    },
    "impact_summary": {
      "type": ["object", "null"],
      "description": "Filled only by the domain axis. Other axes must set null.",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "string",
          "description": "Affected layers/modules (e.g. 'apps/api + apps/web')."
        },
        "backward_compat": {
          "type": "string",
          "description": "Backward compat impact summary."
        },
        "external_integration": {
          "type": "string",
          "description": "External services touched (or 'none')."
        },
        "env_settings": {
          "type": "string",
          "description": "Per-env config coverage notes (or 'n/a')."
        },
        "other_notes": {
          "type": "string",
          "description": "Free-form additional domain notes."
        }
      }
    }
  }
}
