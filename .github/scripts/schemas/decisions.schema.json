{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodexTechLeadDecisions",
  "description": "Output schema for the tech-lead axis in Stage 2 of Codex PR review v2. OpenAI structured outputs strict mode requires every property to appear in `required` and uses type unions with 'null' to express optionality.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions", "judgment", "merge_notes"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "allow", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(correctness|security|performance|test-coverage|domain)-[0-9]+$"
          },
          "allow": { "type": "boolean" },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "judgment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "headline"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["LGTM", "NEEDS_CLARIFICATION", "NEEDS_WORK"]
            },
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        { "type": "null" }
      ]
    },
    "merge_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primary_id", "merged_ids", "reason"],
        "properties": {
          "primary_id": {
            "type": "string",
            "pattern": "^(correctness|security|performance|test-coverage|domain)-[0-9]+$"
          },
          "merged_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(correctness|security|performance|test-coverage|domain)-[0-9]+$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
